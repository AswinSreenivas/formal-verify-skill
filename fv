        text = f"proved — {r['rules']} rule(s), {r['caught']} mutant(s) caught"
        if r["bounds"]:
            text += f"; bounds: {r['bounds']}"
        return text
    if v in STATE_TEXT:
        return STATE_TEXT[v].format(outcome=r["outcome"])
    return f"{v} — {r['note']}" if r["note"] else v


