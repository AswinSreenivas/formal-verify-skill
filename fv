def cmd_check(args):
    root = repo_root()
    d = resolve_dir(root, args.dir)
    src, _ = source_for(root, args)
    kind, model_name, _, rules_of, _, rule_names = engine_for(d)
    for f in [*rule_names, model_name]:
        if not (d / f).exists():
            sys.exit(f"fv: {d / f} missing")
    state, _, ref = proof_state(root, d, src)
    if state == "no-source-ref":
        sys.exit(f"fv: {d.name} has no usable source.ref — create it with `fv snapshot`")
    if state in ("unapproved", "rule-changed"):
        sys.exit(f"fv: rule files are {state} — the user must approve them (`fv approve {d.name}`) before checking")
    if state == "stale":
        sys.exit(f"fv: source changed since snapshot ({src.label}) — re-run `fv snapshot` and re-check the model")
    if state == "source-missing":
        hint = f" — it was snapshotted from PR #{ref['pr']}; re-run with `--pr {ref['pr']}`" if ref.get("pr") and not src.pr else ""
        sys.exit(f"fv: {ref.get('file')}:{ref.get('name')} not found in the {src.label}{hint}")
    raw = (d / model_name).read_text()
    bad = model_shortcut(kind, raw)
    if bad:
        sys.exit("fv: " + bad)
    pointer_errors, pointer_warnings = check_pointers(ref, raw, src)
    if pointer_errors:
        sys.exit("fv: " + "; ".join(pointer_errors))
    if not rules_of(d):
        sys.exit("fv: no rules found — rule.dfy needs `ensures` lines, rule.cfg needs INVARIANT/PROPERTY entries")

    started = datetime.datetime.now()
    ev = evaluate(d)
    main = ev["main"]
    log = [f"===== {model_name}", main["log"]] + [x for n, r in ev["mutants"].items() for x in (f"===== {n}", r["log"])]
    result = read_json(d / "result.json", {}) or {}
    result.update({"engine": kind, "checked_at": now(), "checked_against": src.label,
                   "commit": src.commit or git_head(root), "note": "", "rules": sorted(ev["rules"]),
                   "bounds": tla_bounds(d) if kind == "tla" else None,
                   "stats": main["stats"], "errors": main["errors"], "pointer_warnings": pointer_warnings,
                   "mutants": {n: {"ok": r["ok"], "violated": sorted(r["violated"]), "why": r["why"]}
                               for n, r in ev["mutants"].items()}})

    if ev["outcome"] == "failed":
        attempts = int(result.get("attempts", 0)) + 1
        result.update({"outcome": "failed", "attempts": attempts})
        finish(d, result, log, started)
        broken = ", ".join(sorted(main["violated"])) or "-"
        print(f"FAILED  {d.name}  attempt {attempts}/{MAX_ATTEMPTS}  ({main['why']})  rules broken: {broken}  "
              f"log: {d / 'last.log'}")
        for e in main["errors"][:10]:
            print("  " + fmt_error(e))
        if not main["errors"]:
            print("\n".join(main["log"].strip().splitlines()[-15:]))
        if attempts >= MAX_ATTEMPTS:
            print(f"attempt cap reached — stop and `fv mark {d.name} gave_up` (or a counterexample outcome)")
        return 1

    result.update({"outcome": ev["outcome"], "attempts": 0, "uncovered_rules": ev["uncovered"],
                   "invalid_mutants": ev["invalid"], "survived_mutants": ev["survived"]})
    finish(d, result, log, started)
    print(f"{ev['outcome'].upper()}  {d.name}  ({kind}, {result['seconds']}s, stats {main['stats']})")
    for name, r in ev["mutants"].items():
        print(f"  mutant {name}: {fmt_mutant(r)}")
    if ev["outcome"] == "needs-mutants":
        print(f"  write at least one {ev['mutant_glob']} per rule; until then this is not a proof")
    for rid in ev["uncovered"]:
        print(f"  rule never shown failing: {rid}  {ev['rules'][rid] if ev['rules'][rid] != rid else ''}".rstrip())
    for w in pointer_warnings:
        print(f"  warning: {w}")
    return 0 if ev["outcome"] == "proved" else 1


def git_head(root):
    p = sh(["git", "rev-parse", "--short", "HEAD"], cwd=root, check=False)
    return p.stdout.strip() if p.returncode == 0 else None


def finish(d, result, log, started):
    result["seconds"] = round((datetime.datetime.now() - started).total_seconds(), 1)
    (d / "last.log").write_text("\n".join(log))
    write_json(d / "result.json", result)


