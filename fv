#!/usr/bin/env python3
"""fv — formal-verify harness: the mechanical half of the /formal-verify skill.
Claude writes the models; fv finds targets, pins source + rules, runs the checker
(Dafny for per-input logic, TLA+/TLC for event ordering), and keeps score.
See SKILL.md next to this file.

    fv doctor                                   # dafny / java / tla2tools present? flags? disk
    fv selftest                                 # negative controls: does fv still read the checkers right?
    fv targets [--base B | --pr N]              # changed functions in the diff + proof status
    fv snapshot <file:name> | english:<slug>    # create/refresh a proof dir, pin the source hash
    fv skip <file:name> --note "why"            # record a deliberate skip (plumbing, IO, ...)
    fv approve <proof-dir>                      # the user approved the rule files: pin their hash
    fv check <proof-dir>                        # check the model, then every mutant must FAIL
    fv mark <proof-dir> <outcome> [--note ..]   # bug | model-mismatch | unconfirmed | gave_up | skipped
    fv status                                   # every proof for this repo, stale ones flagged
    fv report [--base B | --pr N | --all]       # markdown for the PR body + a Proof-of-Validation row

--pr N (on targets, snapshot, skip, check, status, report) reads the code from PR N's
head commit — fetched with gh + git fetch, the working tree is never touched — so it
works from any checkout of the repo without switching branches.

A proof dir holds either a Dafny proof (rule.dfy + model.dfy) or a TLA+ model
(rule.tla + rule.cfg + Model.tla), plus mutant_<name>.dfy / mutant_<name>.tla:
deliberately broken copies of the model. `proved` needs the model to pass AND
every rule to be broken by at least one mutant that the checker catches.

Proof dirs live in ~/.claude/formal-proofs/<repo>/<slug>/ and survive across
sessions; every worktree of a repo shares them. A proof counts only while
source.sha matches the code AND the rule files match the hash pinned by `fv approve`.
"""
import argparse
import ast
import datetime
import hashlib
import json
import re
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
PROOFS_ROOT = Path.home() / ".claude" / "formal-proofs"
MAX_ATTEMPTS = 5
CHECK_TIMEOUT_S = 600
# Wanted `dafny verify` flags; `doctor`/`check` keep only those this dafny's --help lists.
WANTED_FLAGS = [["--cores", "4"], ["--verification-time-limit", "60"]]
# Shortcuts that make a proof vacuous. The model may not use any of them.
CHEATS = [
    (re.compile(r"\bassume\b"), "assume"),
    (re.compile(r"\{:\s*axiom\b"), "{:axiom}"),
    (re.compile(r"\{:\s*verify\s+false\s*\}"), "{:verify false}"),
    (re.compile(r"\{:\s*extern\b"), "{:extern}"),
    (re.compile(r"\{:\s*only\b"), "{:only}"),  # verifies only that member, the rest go unchecked
    (re.compile(r"\bdecreases\s*\*"), "decreases *"),  # may not terminate → ensures hold vacuously
]
TLA_JAR_DEFAULT = HERE / "tools" / "tla2tools.jar"
TLC_WORKERS = "4"
TLC_HEAP = "-Xmx4g"  # 16 GB machine; TLC's state store spills to the temp metadir
# `file:line` pointers from model parts to the real code a reviewer can open
POINTER = re.compile(r"([\w./-]+\.(?:py|ts|tsx|sql)):(\d+)")
TEST_PATH = re.compile(r"(^|/)tests?/|(^|/)test_[^/]*\.py$|_test\.py$|\.(test|spec)\.ts$")
LANG_BY_EXT = {".py": "python", ".ts": "typescript"}
ENGINE_LABEL = {"dafny": "Dafny", "tla": "TLA+"}
# A verdict that closes a changed function for the PR gate.
GATE_OK = ("proved", "skipped")
# A proof-dir state under which the recorded outcome no longer describes the code or rules.
NOT_CURRENT = ("stale", "rule-changed", "unapproved", "source-missing", "no-source-ref")


def sh(cmd, cwd=None, check=True):
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    if check and p.returncode != 0:
        sys.exit(f"fv: {' '.join(cmd)} failed:\n{p.stderr.strip()}")
    return p


def repo_root():
    p = sh(["git", "rev-parse", "--show-toplevel"], check=False)
    if p.returncode != 0:
        sys.exit("fv: run inside a git checkout")
    return Path(p.stdout.strip())


def repo_name(root):
    """The repo's name, the same from every worktree: the main checkout's dir (or bare repo name)."""
    p = sh(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], cwd=root, check=False)
    common = Path(p.stdout.strip()) if p.returncode == 0 and p.stdout.strip() else root / ".git"
    name = common.parent.name if common.name == ".git" else common.name
    return name[:-4] if name.endswith(".git") else name


def proofs_dir(root):
    return PROOFS_ROOT / repo_name(root)


def current_branch(root):
    p = sh(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=root, check=False)
    b = p.stdout.strip()
    return b if p.returncode == 0 and b and b != "HEAD" else None


def sha(text):
    norm = "\n".join(line.rstrip() for line in text.strip().splitlines())
    return hashlib.sha256(norm.encode()).hexdigest()


def now():
    return datetime.datetime.now().isoformat(timespec="seconds")


def read_json(path, default=None):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write_json(path, data):
    path.write_text(json.dumps(data, indent=2) + "\n")


# ── where the code is read from ──────────────────────────────────────────────

class Source:
    """The working tree (default), or one commit — a PR's head in PR mode."""

    def __init__(self, root, commit=None, label="working tree", pr=None):
        self.root, self.commit, self.label, self.pr = root, commit, label, pr

    def read(self, rel):
        if self.commit is None:
            path = self.root / rel
            return path.read_text() if path.is_file() else None
        p = sh(["git", "show", f"{self.commit}:{rel}"], cwd=self.root, check=False)
        return p.stdout if p.returncode == 0 else None


def resolve_pr(root, number):
    """PR → its info + base ref. Fetches the PR head and base branch; never touches the working tree."""
    out = sh(["gh", "pr", "view", str(number), "--json",
              "number,url,state,baseRefName,headRefName,headRefOid"], cwd=root).stdout
    info = json.loads(out)
    sh(["git", "fetch", "-q", "origin", f"pull/{number}/head", info["baseRefName"]], cwd=root)
    head = info["headRefOid"]
    if sh(["git", "cat-file", "-e", f"{head}^{{commit}}"], cwd=root, check=False).returncode != 0:
        sys.exit(f"fv: PR #{number} head {head[:10]} isn't in the fetched objects — it was probably "
                 "pushed a moment ago; re-run")
    info["base"] = f"origin/{info['baseRefName']}"
    return info


def source_for(root, args):
    """(Source, PR info or None) from the command's --pr flag."""
    number = getattr(args, "pr", None)
    if number is None:
        return Source(root), None
    info = resolve_pr(root, number)
    head = info["headRefOid"]
    return Source(root, head, f"PR #{number} @ {head[:10]}", pr=number), info


# ── source extraction ────────────────────────────────────────────────────────

def py_functions(text):
    """(qualified name, start, end) for every module-level function and class method."""
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return []
    out = []
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            start = min([node.lineno] + [d.lineno for d in node.decorator_list])
            out.append((node.name, start, node.end_lineno))
        elif isinstance(node, ast.ClassDef):
            for sub in node.body:
                if isinstance(sub, (ast.FunctionDef, ast.AsyncFunctionDef)):
                    start = min([sub.lineno] + [d.lineno for d in sub.decorator_list])
                    out.append((f"{node.name}.{sub.name}", start, sub.end_lineno))
    return out


TS_HEADERS = [
    re.compile(r"^\s*(?:export\s+)?(?:default\s+)?(?:async\s+)?function\s*\*?\s*(\w+)"),
    re.compile(r"^\s*(?:export\s+)?(?:const|let)\s+(\w+)\s*(?::[^=]+)?=\s*(?:async\s*)?(?:\([^)]*\)|\w+)\s*(?::[^=]+)?=>"),
    re.compile(r"^\s+(?:(?:public|private|protected|static|async|readonly|override)\s+)*(\w+)\s*(?:<[^>]*>)?\([^;]*\)\s*(?::\s*[^{;]+)?\{\s*$"),
]
TS_NOT_METHODS = {"if", "for", "while", "switch", "catch", "function", "return", "constructor"}


def ts_functions(text):
    """(name, start, end) via header regex + naive brace matching (ignores braces in strings)."""
    lines = text.splitlines()
    out = []
    for i, line in enumerate(lines):
        name = None
        for rx in TS_HEADERS:
            m = rx.match(line)
            if m and m.group(1) not in TS_NOT_METHODS:
                name = m.group(1)
                break
        if not name:
            continue
        depth, opened, end = 0, False, None
        for j in range(i, len(lines)):
            for ch in lines[j]:
                if ch == "{":
                    depth += 1
                    opened = True
                elif ch == "}":
                    depth -= 1
            if opened and depth <= 0:
                end = j + 1
                break
            if not opened and j > i and lines[j].rstrip().endswith(";"):
                end = j + 1  # expression-bodied arrow function
                break
        out.append((name, i + 1, end or i + 1))
    return out


def functions_in(path, text):
    lang = LANG_BY_EXT.get(Path(path).suffix)
    if lang == "python":
        return py_functions(text)
    if lang == "typescript":
        return ts_functions(text)
    return []


def repo_relpath(root, rel):
    p = Path(rel)
    if p.is_absolute():
        try:
            p = p.resolve().relative_to(root.resolve())
        except ValueError:
            sys.exit(f"fv: {rel} is outside the repo {root}")
    return Path(os.path.normpath(p)).as_posix()


def extract(root, ref, src):
    """Source snippet for 'path:name' as `src` sees it. Returns (relpath, name, lang, snippet)."""
    rel, _, name = ref.rpartition(":")
    if not rel or not name:
        sys.exit(f"fv: target must be <file>:<function> (or english:<slug>), got {ref!r}")
    rel = repo_relpath(root, rel)
    lang = LANG_BY_EXT.get(Path(rel).suffix)
    if not lang:
        sys.exit(f"fv: {Path(rel).suffix} not supported for snapshot; use english:<slug> and model it by hand")
    text = src.read(rel)
    if text is None:
        sys.exit(f"fv: no such file {rel} in the {src.label}")
    lines = text.splitlines()
    matches = [f for f in functions_in(rel, text) if f[0] == name or f[0].endswith("." + name)]
    if not matches:
        sys.exit(f"fv: no function {name!r} in {rel} ({src.label})")
    if len(matches) > 1:
        names = ", ".join(f"{n} (line {s})" for n, s, _ in matches)
        sys.exit(f"fv: {name!r} is ambiguous in {rel}: {names}; use Class.method")
    qname, start, end = matches[0]
    return rel, qname, lang, "\n".join(lines[start - 1:end])


def slug_for(rel, name):
    return re.sub(r"[^A-Za-z0-9_.-]+", "__", rel) + "." + name


# ── diff ─────────────────────────────────────────────────────────────────────

HUNK = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,(\d+))? @@")


def changed_ranges(root, base, head=None):
    """{relpath: [(start, end), ...] or None for 'whole file'}.
    head=None: merge-base..working tree, plus untracked files. head=<commit>: merge-base..head only."""
    if head is None:
        sh(["git", "fetch", "-q", "origin", base.split("/", 1)[-1]], cwd=root, check=False)
    mb = sh(["git", "merge-base", base, head or "HEAD"], cwd=root).stdout.strip()
    cmd = ["git", "diff", "-U0", "--no-color", "--no-ext-diff", "--src-prefix=a/", "--dst-prefix=b/", mb]
    diff = sh(cmd + ([head] if head else []) + ["--", "*.py", "*.ts"], cwd=root).stdout
    ranges, cur = {}, None
    for line in diff.splitlines():
        if line.startswith("+++ "):
            cur = None if line.endswith("/dev/null") else line[6:]
            if cur:
                ranges.setdefault(cur, [])
        elif cur and (m := HUNK.match(line)):
            start, count = int(m.group(1)), int(m.group(2) if m.group(2) is not None else 1)
            # a pure deletion (count 0) still changes the function around it
            ranges[cur].append((start, start + max(count, 1) - 1))
    if head is None:
        untracked = sh(["git", "ls-files", "--others", "--exclude-standard", "--", "*.py", "*.ts"], cwd=root).stdout
        for rel in untracked.split():
            ranges[rel] = None
    return {r: v for r, v in ranges.items() if not TEST_PATH.search(r) and not r.endswith(".d.ts")}


def changed_functions(root, src, base, head=None):
    """[(relpath, name, start, end)] for every function the diff touches, read from `src`."""
    out = []
    for rel, hunks in sorted(changed_ranges(root, base, head).items()):
        text = src.read(rel)
        if text is None:
            continue
        for name, start, end in functions_in(rel, text):
            if hunks is None or any(s <= end and e >= start for s, e in hunks):
                out.append((rel, name, start, end))
    return out


def default_base(root):
    p = sh(["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"], cwd=root, check=False)
    return p.stdout.strip() if p.returncode == 0 and p.stdout.strip() else "origin/main"


# ── proof dir state ──────────────────────────────────────────────────────────

def rule_files(d):
    """rule.dfy, or rule.tla + rule.cfg — the trusted part the user approves."""
    return sorted(p for p in d.glob("rule.*") if p.name != "rule.sha")


def rule_hash(d):
    files = rule_files(d)
    return sha("\n".join(f"{p.name}\n{p.read_text()}" for p in files)) if files else None


def proof_state(root, d, src):
    """(state, outcome, ref). state is fresh | stale | source-missing | english | no-source-ref,
    or unapproved | rule-changed when the rule files aren't the approved ones. A skip has no rules,
    so only the code decides whether it still holds."""
    ref = read_json(d / "source.ref", {}) or {}
    result = read_json(d / "result.json", {}) or {}
    outcome = result.get("outcome", "unchecked")
    if ref.get("kind") == "english":
        state = "english"
    elif ref.get("kind") == "code" and ref.get("file") and ref.get("name"):
        try:
            _, _, _, snippet = extract(root, f"{ref['file']}:{ref['name']}", src)
        except SystemExit:
            state = "source-missing"
        else:
            pinned = (d / "source.sha").read_text().strip() if (d / "source.sha").exists() else None
            state = "fresh" if sha(snippet) == pinned else "stale"
    else:
        state = "no-source-ref"
    if outcome == "skipped" or state == "no-source-ref":
        return state, outcome, ref
    approved = (d / "rule.sha").read_text().strip() if (d / "rule.sha").exists() else None
    if not approved:
        return "unapproved", outcome, ref
    if rule_hash(d) != approved:
        return "rule-changed", outcome, ref
    return state, outcome, ref


def all_proofs(root):
    base = proofs_dir(root)
    return sorted(p for p in base.iterdir() if p.is_dir()) if base.exists() else []


def resolve_dir(root, arg):
    p = Path(arg).expanduser()
    if p.is_dir():
        return p.resolve()
    p = proofs_dir(root) / arg
    if p.is_dir():
        return p
    sys.exit(f"fv: no proof dir {arg!r} (see `fv status`)")


# ── checkers ─────────────────────────────────────────────────────────────────
# Each engine runs one model file and returns
#   {"ok": True|False|None, "violated": set of rule ids, "errors": [...], "why": str, "stats": {...}, "log": str}
# ok=False: the checker reached the rules and found a violation (a real counterexample).
# ok=None:  nothing was really checked — parse/type error, timeout, a body-less method,
#           zero reachable states. Such a mutant proves nothing, so it never counts as "caught",
#           and such a model never counts as passing.

def dafny_flags(dafny):
    help_text = sh([dafny, "verify", "--help"], check=False)
    text = help_text.stdout + help_text.stderr
    kept = [f for f in WANTED_FLAGS if f[0] in text]
    return [x for f in kept for x in f], [f[0] for f in WANTED_FLAGS if f not in kept]


def find_dafny():
    dafny = shutil.which("dafny")
    if not dafny:
        sys.exit("fv: dafny not installed. Install with `brew install dafny` (pulls dotnet@8 + z3; "
                 "check free disk first — `fv doctor`).")
    return dafny


def find_java():
    """A java that actually runs — macOS ships a /usr/bin/java stub with no runtime behind it."""
    for cand in [os.environ.get("JAVA"), "/opt/homebrew/opt/openjdk/bin/java", shutil.which("java")]:
        if cand and Path(cand).exists() and sh([cand, "-version"], check=False).returncode == 0:
            return cand
    return None


def find_tla_jar():
    jar = Path(os.environ.get("TLA2TOOLS", TLA_JAR_DEFAULT)).expanduser()
    return jar if jar.is_file() else None


def run(cmd, cwd):
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=CHECK_TIMEOUT_S)
        return p.returncode, p.stdout + p.stderr
    except subprocess.TimeoutExpired:
        return -1, f"fv: timed out after {CHECK_TIMEOUT_S}s — shrink the bounds or split the rule"


DAFNY_LINE = re.compile(r"^(?P<file>[^\s(]+\.dfy)\((?P<line>\d+),(?P<col>\d+)\): "
                        r"(?P<kind>Error|Warning|Related location)[^:]*: (?P<msg>.*)$")
SUMMARY = re.compile(r"finished with (\d+) verified, (\d+) errors?[^\n]*")
INCOMPLETE = re.compile(r"time ?outs?|timed out|out of resource|inconclusive", re.I)


def dafny_rules(d):
    """Rule ids = 'rule.dfy:<line>' of every `ensures` line in rule.dfy."""
    lines = (d / "rule.dfy").read_text().splitlines()
    return {f"rule.dfy:{i}": l.strip() for i, l in enumerate(lines, 1) if re.match(r"\s*ensures\b", l)}


def run_dafny(d, model_name):
    dafny = find_dafny()
    flags, _ = dafny_flags(dafny)
    code, out = run([dafny, "verify", *flags, model_name], d)
    entries = [m.groupdict() for m in map(DAFNY_LINE.match, out.splitlines()) if m]
    # An Error is a counterexample unless it is a timeout. Its "Related location" lines that land in
    # rule.dfy name the approved ensures it broke; those after a Warning (e.g. "this ensures is part
    # of a bodyless method") broke nothing.
    violated, failures, warnings, primary = set(), [], [], None
    for e in entries:
        if e["kind"] == "Related location":
            if primary == "failure" and Path(e["file"]).name == "rule.dfy":
                violated.add(f"rule.dfy:{e['line']}")
            continue
        if e["kind"] == "Warning":
            primary = "warning"
            warnings.append(e)
        elif INCOMPLETE.search(e["msg"]):
            primary = "incomplete"
        else:
            primary = "failure"
            failures.append(e)
            if Path(e["file"]).name == "rule.dfy":
                violated.add(f"rule.dfy:{e['line']}")
    summary = SUMMARY.search(out)
    verified = int(summary.group(1)) if summary else None
    incomplete = bool(summary and INCOMPLETE.search(summary.group(0)))
    if summary and failures:
        ok, why = False, "counterexample"
    elif code == 0 and summary and verified and not warnings and not incomplete:
        ok, why = True, ""
    elif not summary:
        ok, why = None, "never reached the verifier (parse / resolution / type error)"
    elif incomplete:
        ok, why = None, "verification timed out or ran out of resources"
    elif warnings:
        ok, why = None, f"{len(warnings)} warning(s), e.g. a method with no body: {warnings[0]['msg'][:90]}"
    elif not verified:
        ok, why = None, "0 verified — nothing was checked"
    else:
        ok, why = None, f"dafny exited {code} without a counterexample"
    stats = {"verified": verified}
    return {"ok": ok, "violated": violated, "errors": entries[:20], "why": why, "stats": stats, "log": out}


TLC_VIOLATION = re.compile(r"Error: (?:Invariant|Property|Action property) (\w+) is violated")
TLC_STATES = re.compile(r"([\d,]+) states generated, ([\d,]+) distinct states found")


def tla_rules(d):
    """Rule ids = names listed under INVARIANT(S) / PROPERTY(IES) in rule.cfg."""
    names, mode = {}, False
    for raw in (d / "rule.cfg").read_text().splitlines():
        line = raw.split("\\*")[0].strip()
        if not line:
            continue
        head, _, rest = line.partition(" ")
        if head.upper() in ("INVARIANT", "INVARIANTS", "PROPERTY", "PROPERTIES"):
            mode = True
            line = rest
        elif re.match(r"^[A-Z_]+$", head):  # another cfg section (CONSTANTS, SPECIFICATION, ...)
            mode = False
            continue
        if mode:
            for n in line.split():
                names[n] = n
    return names


def tla_bounds(d):
    """The CONSTANTS lines of rule.cfg, e.g. 'Requests = {r1, r2}; Years = 3' — a TLC pass holds only within them."""
    out, mode = [], False
    for raw in (d / "rule.cfg").read_text().splitlines():
        line = raw.split("\\*")[0].strip()
        if not line:
            continue
        head, _, rest = line.partition(" ")
        if head.upper() in ("CONSTANT", "CONSTANTS"):
            mode, line = True, rest.strip()
        elif re.match(r"^[A-Z_]+$", head):
            mode = False
            continue
        if mode and line:
            out.append(line)
    return "; ".join(out)


def run_tla(d, model_name):
    java, jar = find_java(), find_tla_jar()
    if not java:
        sys.exit("fv: no working Java runtime. Install with `brew install openjdk` (~200 MB) — ask the user first.")
    if not jar:
        sys.exit(f"fv: tla2tools.jar not found at {TLA_JAR_DEFAULT} (or $TLA2TOOLS). Download the release jar "
                 "from github.com/tlaplus/tlaplus/releases — ask the user first.")
    # rule.tla EXTENDS Model, so the model (or mutant) is staged as Model.tla in a scratch dir.
    # TLC's state store goes in there too and is deleted on exit — it can reach GBs.
    work = Path(tempfile.mkdtemp(prefix="fv-tlc-"))
    try:
        shutil.copy(d / "rule.tla", work / "rule.tla")
        shutil.copy(d / "rule.cfg", work / "rule.cfg")
        shutil.copy(d / model_name, work / "Model.tla")
        code, out = run([java, TLC_HEAP, "-XX:+UseParallelGC", "-cp", str(jar), "tlc2.TLC",
                         "-workers", TLC_WORKERS, "-metadir", str(work / "states"),
                         "-config", "rule.cfg", "rule.tla"], work)
    finally:
        shutil.rmtree(work, ignore_errors=True)
    violated = set(TLC_VIOLATION.findall(out))
    if "Deadlock reached" in out:
        violated.add("deadlock")
    states = TLC_STATES.search(out)
    distinct = int(states.group(2).replace(",", "")) if states else None
    stats = {"distinct_states": distinct,
             "trace_steps": len(re.findall(r"^State \d+:", out, flags=re.M))}
    if violated:
        ok, why = False, "counterexample"
    elif code == 0 and "No error has been found" in out and distinct:
        ok, why = True, ""
    elif code == 0 and "No error has been found" in out:
        # TLC passes a spec with no reachable states: every invariant holds vacuously
        ok, why = None, "0 reachable states — Init is unsatisfiable, nothing was checked"
    else:
        ok, why = None, "never finished checking (parse / semantic / config error, or timeout)"
    errors = [{"msg": l.strip()} for l in out.splitlines() if l.startswith("Error:")][:20]
    return {"ok": ok, "violated": violated, "errors": errors, "why": why, "stats": stats, "log": out}


def engine_for(d):
    has_dfy, has_tla = (d / "model.dfy").exists(), (d / "Model.tla").exists()
    if has_dfy == has_tla:
        sys.exit("fv: a proof dir needs exactly one model — model.dfy (Dafny) or Model.tla (TLA+)")
    if has_dfy:
        return "dafny", "model.dfy", "mutant_*.dfy", dafny_rules, run_dafny, ["rule.dfy"]
    return "tla", "Model.tla", "mutant_*.tla", tla_rules, run_tla, ["rule.tla", "rule.cfg"]


def strip_dafny_comments(text):
    # blank out comments (keeping newlines, so line numbers hold) — "we assume" in prose isn't a cheat
    return re.sub(r"//[^\n]*|/\*.*?\*/", lambda m: re.sub(r"[^\n]", " ", m.group(0)), text, flags=re.S)


def model_shortcut(kind, raw):
    """A reason the model can't be trusted before it is even run, or None."""
    if kind != "dafny":
        return None
    text = strip_dafny_comments(raw)
    if not re.search(r'include\s+"rule\.dfy"', text) or not re.search(r"\brefines\b", text):
        return 'model.dfy must `include "rule.dfy"` and declare a module that `refines` the rule module'
    for rx, label in CHEATS:
        for m in rx.finditer(text):
            line = text.count("\n", 0, m.start()) + 1
            return f"model.dfy:{line} uses {label} — not allowed, it makes the proof vacuous"
    return None


def check_pointers(ref, text, src):
    """Every model must point at the real code it models (`file:line`), and the lines must exist."""
    if ref.get("kind") != "code":
        return [], []
    found = POINTER.findall(text)
    if not found:
        return [f"model has no `file:line` pointers into {ref['file']} — every function/action/step "
                "must name the code it models"], []
    warnings = []
    for rel, line in sorted(set(found)):
        target = src.read(rel)
        if target is None and Path(rel).name == Path(ref["file"]).name:
            target = src.read(ref["file"])  # a bare `billing.py:42` points into the target's file
        if target is None:
            warnings.append(f"pointer {rel}:{line} doesn't resolve to a file in the {src.label}")
        elif int(line) > len(target.splitlines()):
            warnings.append(f"pointer {rel}:{line} is past the end of the file in the {src.label}")
    return [], warnings


def evaluate(d):
    """Run the model, then every mutant. Shared by `check` and `selftest`; touches no git state."""
    kind, model_name, mutant_glob, rules_of, runner, _ = engine_for(d)
    rules = rules_of(d)
    ev = {"kind": kind, "model": model_name, "mutant_glob": mutant_glob, "rules": rules,
          "main": runner(d, model_name), "mutants": {}, "survived": [], "invalid": [], "uncovered": []}
    if ev["main"]["ok"] is not True:
        ev["outcome"] = "failed"
        return ev
    # The model passes. Now every mutant (a deliberately broken copy) must FAIL, and between
    # them they must break every rule — a rule never seen failing proves nothing.
    covered = set()
    for mut in sorted(d.glob(mutant_glob)):
        r = runner(d, mut.name)
        ev["mutants"][mut.name] = r
        if r["ok"] is True:
            ev["survived"].append(mut.name)
        elif r["ok"] is None:
            ev["invalid"].append(mut.name)
        else:
            covered |= r["violated"] & set(rules)
    ev["uncovered"] = sorted(set(rules) - covered)
    if not ev["mutants"]:
        ev["outcome"] = "needs-mutants"
    elif ev["survived"]:
        ev["outcome"] = "mutant-survived"
    elif ev["uncovered"]:
        ev["outcome"] = "proved-partial"
    else:
        ev["outcome"] = "proved"
    return ev


def fmt_error(e):
    return f"{e['file']}:{e['line']}  {e['kind']}: {e['msg']}" if "file" in e else e["msg"]


def fmt_mutant(r):
    if r["ok"] is True:
        return "SURVIVED (checker missed it)"
    if r["ok"] is None:
        return f"INVALID ({r['why']})"
    return "caught → " + (", ".join(sorted(r["violated"])) or "?")


