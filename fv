def report_rows(root, src, pr, args):
    """(title, rows) for the report's scope: a PR, the current diff, or every proof (--all)."""
    if args.all:
        return f"all proofs in {repo_name(root)} ({src.label})", [proof_row(root, d, src) for d in all_proofs(root)]
    base = pr["base"] if pr else (args.base or default_base(root))
    branch = pr["headRefName"] if pr else current_branch(root)
    title = (f"PR #{pr['number']} @ `{src.commit[:10]}` vs `{base}`" if pr
             else f"`{branch or git_head(root)}` (working tree) vs `{base}`")
    rows = []
    for rel, name, _, _ in changed_functions(root, src, base, src.commit):
        d = proofs_dir(root) / slug_for(rel, name)
        target = f"{rel}:{name}"
        if d.is_dir():
            rows.append(proof_row(root, d, src, target))
        else:
            rows.append({"target": target, "dir": None, "state": "needs-proof", "outcome": "-",
                         "verdict": "needs-proof", "engine": None, "note": "", "rules": 0, "caught": 0,
                         "bounds": None, "statement": ""})
    # plain-English proofs aren't in any diff: include those tied to this PR or its branch
    for d in all_proofs(root):
        ref = read_json(d / "source.ref", {}) or {}
        if ref.get("kind") == "english" and (
                (pr and ref.get("pr") == pr["number"]) or (branch and ref.get("branch") == branch)):
            rows.append(proof_row(root, d, src))
    return title, rows


def cell(text):
    """Markdown-table-safe: one line, no bare pipes."""
    return " ".join(str(text).split()).replace("|", "\\|")


def result_text(r):
    v = r["verdict"]
