def proof_row(root, d, src, target=None):
    state, outcome, ref = proof_state(root, d, src)
    result = read_json(d / "result.json", {}) or {}
    if target is None:
        target = (f"{ref.get('file')}:{ref.get('name')}" if ref.get("kind") == "code"
                  else f"english:{ref.get('name', d.name)}")
    # a verdict counts only while the code and the approved rules are what was checked
    verdict = state if state in NOT_CURRENT else outcome
    return {"target": target, "dir": d.name, "state": state, "outcome": outcome, "verdict": verdict,
            "engine": result.get("engine") if outcome != "skipped" else None,
            "note": result.get("note", ""), "rules": len(result.get("rules", [])),
            "caught": sum(1 for m in (result.get("mutants") or {}).values() if m.get("ok") is False),
            "bounds": result.get("bounds"), "statement": ref.get("statement", "")}


