    return 0


# ── selftest: the negative controls, so a checker upgrade can't silently break parsing ──

ST_DFY_RULE = """abstract module Rule {
  // clamp x into [lo, hi]
  method Clamp(x: int, lo: int, hi: int) returns (r: int)
    requires lo <= hi
    ensures lo <= r
    ensures r <= hi
}
"""


def st_dfy_model(body):
    if body is None:
        return 'include "rule.dfy"\nmodule Model refines Rule { }\n'
    return ('include "rule.dfy"\nmodule Model refines Rule {\n'
            f"  method Clamp(x: int, lo: int, hi: int) returns (r: int) {{\n    {body}\n  }}\n}}\n")


ST_TLA_RULE = "---- MODULE rule ----\nEXTENDS Model\nBounded == x <= 3\nNonNeg == x >= 0\n====\n"
ST_TLA_CFG = "SPECIFICATION Spec\nINVARIANT Bounded NonNeg\n"


def st_tla_model(nxt, init="x = 0", extra=""):
    return ("---- MODULE Model ----\nEXTENDS Integers\nVARIABLE x\nvars == <<x>>\n"
            f"Init == {init}\n{extra}\nNext == {nxt}\nSpec == Init /\\ [][Next]_vars\n====\n")


def st_case(tmp, name, files):
    d = tmp / name
    d.mkdir()
    for fname, text in files.items():
        (d / fname).write_text(text)
    return d


def cmd_selftest(args):
    good_dfy = "r := if x < lo then lo else if x > hi then hi else x;"
    count_to = lambda n: f"(x < {n} /\\ x' = x + 1) \\/ (x = {n} /\\ UNCHANGED x)"  # noqa: E731
    down_to = "(x > -1 /\\ x' = x - 1) \\/ (x = -1 /\\ UNCHANGED x)"
    cases = []  # (engine, description, build files, predicate on evaluate() result)
    cases += [
        ("dafny", "correct model + one mutant per ensures → proved, each mutant mapped to its rule line",
         {"rule.dfy": ST_DFY_RULE, "model.dfy": st_dfy_model(good_dfy),
          "mutant_no_lo.dfy": st_dfy_model("r := if x > hi then hi else x;"),
          "mutant_no_hi.dfy": st_dfy_model("r := if x < lo then lo else x;")},
         lambda ev: ev["outcome"] == "proved"
         and ev["mutants"]["mutant_no_lo.dfy"]["violated"] == {"rule.dfy:5"}
         and ev["mutants"]["mutant_no_hi.dfy"]["violated"] == {"rule.dfy:6"}),
        ("dafny", "refinement with no body → never passes",
         {"rule.dfy": ST_DFY_RULE, "model.dfy": st_dfy_model(None)},
         lambda ev: ev["main"]["ok"] is not True),
        ("dafny", "body breaking one ensures → counterexample naming exactly that line",
         {"rule.dfy": ST_DFY_RULE, "model.dfy": st_dfy_model("r := if x < lo then lo else x;")},
         lambda ev: ev["main"]["ok"] is False and ev["main"]["violated"] == {"rule.dfy:6"}),
        ("dafny", "body-less mutant → INVALID, not caught",
         {"rule.dfy": ST_DFY_RULE, "model.dfy": st_dfy_model(good_dfy), "mutant_empty.dfy": st_dfy_model(None)},
         lambda ev: ev["mutants"]["mutant_empty.dfy"]["ok"] is None and ev["outcome"] == "proved-partial"),
        ("tla", "correct model + one mutant per invariant → proved, each mutant mapped to its invariant",
         {"rule.tla": ST_TLA_RULE, "rule.cfg": ST_TLA_CFG, "Model.tla": st_tla_model(count_to(3)),
          "mutant_overshoot.tla": st_tla_model(count_to(4)), "mutant_decrement.tla": st_tla_model(down_to)},
         lambda ev: ev["outcome"] == "proved"
         and ev["mutants"]["mutant_overshoot.tla"]["violated"] == {"Bounded"}
         and ev["mutants"]["mutant_decrement.tla"]["violated"] == {"NonNeg"}),
        ("tla", "Next that breaks an invariant → counterexample naming it",
         {"rule.tla": ST_TLA_RULE, "rule.cfg": ST_TLA_CFG, "Model.tla": st_tla_model(count_to(5))},
         lambda ev: ev["main"]["ok"] is False and ev["main"]["violated"] == {"Bounded"}),
        ("tla", "Next == UNCHANGED vars + mutant of a dead action → mutant-survived",
         {"rule.tla": ST_TLA_RULE, "rule.cfg": ST_TLA_CFG, "Model.tla": st_tla_model("UNCHANGED vars"),
          "mutant_dead_action.tla": st_tla_model("UNCHANGED vars", extra="Inc == x' = x + 10")},
         lambda ev: ev["outcome"] == "mutant-survived"),
        ("tla", "unsatisfiable Init (0 reachable states) → never passes",
         {"rule.tla": ST_TLA_RULE, "rule.cfg": ST_TLA_CFG, "Model.tla": st_tla_model("UNCHANGED vars", "x = 0 /\\ x = 1")},
         lambda ev: ev["main"]["ok"] is None),
        ("tla", "mutant with a syntax error → INVALID, not caught",
         {"rule.tla": ST_TLA_RULE, "rule.cfg": ST_TLA_CFG, "Model.tla": st_tla_model(count_to(3)),
          "mutant_syntax.tla": "---- MODULE Model ----\nEXTENDS Integers\nVARIABLE x\nInit == x = \n====\n"},
         lambda ev: ev["mutants"]["mutant_syntax.tla"]["ok"] is None),
    ]
    have = {"dafny": bool(shutil.which("dafny")), "tla": bool(find_java() and find_tla_jar())}
    failed = ran = 0
    # static gate: a model using a proof shortcut is refused before any checker runs
    shortcut = model_shortcut("dafny", st_dfy_model("assume x > 0; r := x;"))
    ok = bool(shortcut and "assume" in shortcut)
    print(f"{'PASS' if ok else 'FAIL'}  static  model using `assume` is refused before checking")
    failed += not ok
    tmp = Path(tempfile.mkdtemp(prefix="fv-selftest-"))
    try:
        for i, (engine, desc, files, pred) in enumerate(cases):
            if not have[engine]:
                print(f"SKIP  {engine:<6}  {desc}  ({engine} not installed — `fv doctor`)")
                continue
            ev = evaluate(st_case(tmp, f"case{i}", files))
            ran += 1
            try:
                ok = bool(pred(ev))
            except KeyError:
                ok = False
            failed += not ok
            print(f"{'PASS' if ok else 'FAIL'}  {engine:<6}  {desc}")
            if not ok:
                print(f"        got: outcome={ev['outcome']}  model ok={ev['main']['ok']} ({ev['main']['why']}) "
                      f"violated={sorted(ev['main']['violated'])}  "
                      + "  ".join(f"{n}: {fmt_mutant(r)}" for n, r in ev["mutants"].items()))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    print(f"\n{ran} checker control(s) ran, {failed} failed")
    if failed:
        print("fv's reading of checker output is broken — fix the parsing in fv before trusting any PROVED")
    return 1 if failed or not ran else 0


def main():
    ap = argparse.ArgumentParser(prog="fv", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    pr_help = "read the code from this PR's head commit (gh + git fetch; the working tree is untouched)"
    sub.add_parser("doctor")
    sub.add_parser("selftest")
    p = sub.add_parser("targets")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--base", help="default: the remote's default branch (origin/HEAD), else origin/main")
    g.add_argument("--pr", type=int, help=pr_help)
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("snapshot")
    p.add_argument("target")
    p.add_argument("--statement", help="plain-English statement, for english:<slug> targets")
    p.add_argument("--pr", type=int, help=pr_help + "; an english: target is tied to this PR in reports")
    p = sub.add_parser("skip")
    p.add_argument("target", help="<file>:<function> from `fv targets`")
    p.add_argument("--note", required=True, help="why it isn't worth a proof, e.g. 'plumbing: logging only'")
    p.add_argument("--pr", type=int, help=pr_help)
    p = sub.add_parser("approve")
    p.add_argument("dir")
    p = sub.add_parser("check")
    p.add_argument("dir")
    p.add_argument("--pr", type=int, help=pr_help)
    p = sub.add_parser("mark")
    p.add_argument("dir")
    p.add_argument("outcome", choices=OUTCOMES)
    p.add_argument("--note")
    p = sub.add_parser("status")
    p.add_argument("--pr", type=int, help=pr_help)
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("report")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--base", help="report the current diff vs this base (default: origin/HEAD)")
    g.add_argument("--pr", type=int, help="report PR N's changed functions, read from its head commit")
    g.add_argument("--all", action="store_true", help="every proof in this repo, not just the diff")
    p.add_argument("--json", action="store_true")
    args = ap.parse_args()
    handler = {
        "doctor": cmd_doctor, "selftest": cmd_selftest, "targets": cmd_targets, "snapshot": cmd_snapshot,
        "skip": cmd_skip, "approve": cmd_approve, "check": cmd_check, "mark": cmd_mark,
        "status": cmd_status, "report": cmd_report,
    }[args.cmd]
    sys.exit(handler(args))


if __name__ == "__main__":
    main()
