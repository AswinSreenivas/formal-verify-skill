def snapshot(root, src, pr, target, statement=None):
    """Create/refresh a proof dir and pin what it covers. Returns the dir."""
    base = proofs_dir(root)
    tags = {"pr": src.pr, "branch": pr["headRefName"] if pr else current_branch(root)}
    if target.startswith("english:"):
        slug = re.sub(r"[^A-Za-z0-9_.-]+", "-", target.split(":", 1)[1]).strip("-")
        d = base / f"english.{slug}"
        d.mkdir(parents=True, exist_ok=True)
        old = read_json(d / "source.ref", {}) or {}
        ref = {"kind": "english", "name": slug, "statement": statement or old.get("statement", "")}
        for k, v in tags.items():  # keep the PR/branch it was first tied to unless given a new one
            ref[k] = v if v is not None else old.get(k)
        write_json(d / "source.ref", ref)
        return d
    rel, name, lang, snippet = extract(root, target, src)
    d = base / slug_for(rel, name)
    d.mkdir(parents=True, exist_ok=True)
    old = (d / "source.sha").read_text().strip() if (d / "source.sha").exists() else None
    new = sha(snippet)
    (d / "source.sha").write_text(new + "\n")
    write_json(d / "source.ref", {"kind": "code", "file": rel, "name": name, "lang": lang,
                                  "snapshot_of": src.label, **tags})
    if old and old != new:
        # source moved on: the old verdict no longer describes this code
        result = read_json(d / "result.json", {}) or {}
        result.update({"outcome": "unchecked", "attempts": 0, "note": "source changed since last check"})
        write_json(d / "result.json", result)
    return d


